@startuml C1_Альтернативное_Решение_Свиноводство

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма системы мониторинга свиноводства - Альтернативное решение

Person(директор, "Директор хозяйства", "Управление через веб-портал")
Person(ветеринар, "Ветеринар", "Отслеживает здоровье поголовья")
Person(оператор, "Оператор фермы", "Контролирует состояние животных и оборудования")
Person(работник, "Работник фермы", "Получает локальные уведомления")
Person(техник, "Техник", "Обслуживает оборудование")

System_Boundary(мониторинг_свиней, "Система мониторинга свиноводства") {
    System(новое_mobile, "Веб-приложение свиноводства", "PWA - сайт, который можно установить как приложение, и использовать как основу для полноценного приложения")
    System(центр_система, "Центральная система мониторинга", "Агрегация данных, аналитика, управление")

    Boundary(агенты_фермы, "Агенты фермы") {
        System(агент_фермы, "Агент фермы", "Локальная обработка, автономная работа")
        System_Ext(iot_devices, "IoT формы", "IP-камеры, датчики, контроллеры кормушек")
    }
}

' Существующие сервисы
System_Ext(существующая_система, "АгроПром Х - Существующая цифровая платформа", "Apache Kafka, ClickHouse, 1С:Агро, MinIO Data Lake")

' Новые сервисы
System_Ext(ml_платформа, "ML Platform", "Платформа машинного обучения партнера")
System_Ext(сервис_уведомлений, "Сервис уведомлений", "SMS/Push/Email")

' Пользовательские взаимодействия
Rel(директор, новое_mobile, "Локальный мониторинг и управление")
Rel(ветеринар, новое_mobile, "Анализ здоровья животных")
Rel(работник, новое_mobile, "Получает локальные оповещения")
Rel(оператор, новое_mobile, "Локальный мониторинг и управление")
Rel(техник, новое_mobile, "Мониторинг оборудования")

' Внешние интеграции центральной системы
BiRel(центр_система, существующая_система, "Основной канал данных")
Rel(центр_система, сервис_уведомлений, "Уведомления")

' Внешние интеграции агента фермы
BiRel(агент_фермы, существующая_система, "Основной канал данных")
Rel(ml_платформа, агент_фермы, "Загрузка модели")
BiRel(iot_devices, агент_фермы, "Датчики и видео\nОтправка команд")

' Новые компоненты
BiRel(агент_фермы, центр_система, "Резервный канал данных")
BiRel(новое_mobile, центр_система, "Оперативный канал")
BiRel(новое_mobile, агент_фермы, "Основной канал")

@enduml